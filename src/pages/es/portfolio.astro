---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/sections/Header.astro";
import Footer from "../../components/sections/Footer.astro";
import Projects from "../../components/sections/Projects.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import GlowLineSeparator from "../../components/ui/separator/GlowLineSeparator.astro";
import { useTranslations } from "../../i18n/ui";

const lang = 'es' as const;
const t = useTranslations(lang);
---

<html lang="es" data-theme="dark" class="dark">
  <head>
    <BaseHead title="Portafolio" description="Experiencia profesional y casos de clientes." />
    <link rel="alternate" hreflang="en" href={new URL('/portfolio', Astro.site).toString()} />
    <link rel="alternate" hreflang="es" href={new URL('/es/portfolio', Astro.site).toString()} />
  </head>
  <body>
    <Header lang={lang} page="portfolio" />
    <main>
      <HeroSection title={t('portfolio.title')} subtitle={t('portfolio.subtitle')} />
      <Projects lang={lang} />
      <GlowLineSeparator />
    </main>
    <Footer lang={lang} />
  </body>
</html>
