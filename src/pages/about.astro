---
import Layout from '../layouts/BlogPost.astro';
import GlowLineSeparator from '@/components/ui/separator/GlowLineSeparator.astro';

const pageTitle = 'About me';
const pageDescription =
  'I help companies streamline their operations through process automation and data analysis.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  pubDate={new Date()}
  showHeader={false}
  lang="en"
  page="about"
 >

<div class="flex justify-center mb-10">
  <img
    src="/BrianFoto.jpg"
    alt="Brian Núñez"
    class="w-56 h-56 md:w-64 md:h-64 rounded-2xl object-cover shadow-xl ring-1 ring-[color:var(--color-border)]"
  />
</div>
<div class="flex justify-center mb-10">
  <div class="w-24 h-[2px] bg-gradient-to-r from-transparent via-[var(--accent)] to-transparent"></div>
</div>

  <p>
    I help companies improve how they operate through process automation and data analysis —
    turning raw data into clear information for better decisions, while cutting manual work,
    operational errors and execution time.
  </p>

  <p>
    I graduated in Systems Engineering from Universidad Peruana de Ciencias Aplicadas (UPC) in 2023.
    Since then I have worked with data across retail, nutrition and construction, focusing on
    organizing information, integrating systems and building practical solutions that support real
    business decisions.
  </p>

  <p>
    Beyond the technology, I get involved by understanding the context of each organization, working
    closely with the teams and focusing on improvements that create real impact from day one.
  </p>

  <GlowLineSeparator />

  <div class="mt-8 flex flex-col items-center gap-3">
    <a
      href="/CV_OscarNunez_EN.pdf"
      target="_blank"
      rel="noopener"
      class="sw-btn"
    >
      Download CV (PDF)
    </a>

    <p class="text-sm text-[color:var(--color-text-muted)] text-center max-w-md">
      A summary of my professional experience.
    </p>
  </div>

  <div class="flex justify-center my-16">
  <div class="w-32 h-[1px] bg-gradient-to-r from-transparent via-[var(--accent)] to-transparent opacity-60"></div>
</div>
</Layout>
