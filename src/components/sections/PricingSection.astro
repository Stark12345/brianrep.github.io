---
interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;

const WHATSAPP = '51940167360';
const wa = (msg: string) => `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;

const content = {
  en: {
    heading: 'What I solve',
    subheading: 'Pick the problem that sounds like your business. Fixed price, fixed timeline, no surprises.',
    popular: 'Most popular',
    cta: 'Talk on WhatsApp',
    plans: [
      {
        name: '"I know something is wrong, I just don\'t know where"',
        price: '$290',
        meta: '1 week',
        pitch: 'I find exactly where your business is losing time and money — and tell you what is worth fixing first.',
        features: [
          'The 3 biggest leaks in your operation, with the cost of each one',
          'What is worth fixing, what is not, and in which order',
          'A plan you can act on even if you never hire me again',
          '100% credited toward any package within 30 days',
        ],
        msg: 'Hi Brian, I want to find out where my business is losing time and money ($290).',
        highlight: false,
      },
      {
        name: '"This task eats my whole week"',
        price: '$790',
        meta: '2 weeks',
        pitch: 'That process you or your team repeat by hand every week? It runs on its own from now on.',
        features: [
          'One full process working without anyone touching it',
          'Works with the tools you already have — nothing to replace',
          'Your team gets it in plain language, not a manual',
          'We measure the time you got back, before and after',
        ],
        msg: 'Hi Brian, I have a manual process that eats my week and I want it automated ($790).',
        highlight: false,
      },
      {
        name: '"I find out too late what happened"',
        price: '$1,490',
        meta: '21 days',
        pitch: 'Stop waiting until month end. See sales, costs, stock and profit of the day on one screen.',
        features: [
          'Your numbers from every source, together and finally trustworthy',
          'The 8 numbers that actually drive your decisions — not 40 charts',
          'Alerts before things go wrong, not after',
          'Your team runs it without depending on anyone',
          '30-day adjustment guarantee',
        ],
        msg: 'Hi Brian, I want to see what is happening in my business without waiting until month end ($1,490).',
        highlight: true,
      },
      {
        name: '"Both of the above"',
        price: '$1,990',
        meta: '30 days',
        pitch: 'Your numbers on one screen, and the work behind them running by itself.',
        features: [
          'Everything in the dashboard package',
          'Plus one full process automated end to end',
          'Both built to work together from day one',
          '30-day adjustment guarantee',
        ],
        msg: 'Hi Brian, I want the dashboard and the automation together ($1,990).',
        highlight: false,
      },
    ],
    retainer: {
      name: 'And after that?',
      pitch: 'Problems keep appearing. This is having someone who already knows your business, without putting them on payroll.',
      note: 'No lock-in. First month 50% off when you come from any package above.',
      tiers: [
        {
          name: 'Essential',
          price: '$450',
          period: '/month',
          features: [
            'Everything we built stays working — I watch it, you do not',
            'The adjustments your business needs that month',
            'You write, I answer within 48h',
            'A monthly note on what changed in your numbers',
          ],
          msg: 'Hi Brian, I want to know more about the Essential monthly plan ($450/month).',
        },
        {
          name: 'Growth',
          price: '$890',
          period: '/month',
          features: [
            'Everything in Essential',
            'One new improvement or automation every month',
            'Priority answer within 24h',
            'Your team learns to use it better every month',
          ],
          msg: 'Hi Brian, I want to know more about the Growth monthly plan ($890/month).',
        },
      ],
    },
    trust: '50% upfront / 50% on delivery · Invoice provided · Remote work worldwide (UTC-5)',
  },

  es: {
    heading: 'Qué te resuelvo',
    subheading: 'Elige el problema que se parece a tu negocio. Precio fijo, plazo fijo, sin sorpresas.',
    popular: 'Más solicitado',
    cta: 'Conversemos por WhatsApp',
    plans: [
      {
        name: '"Algo se me está escapando y no sé qué"',
        price: 'S/ 490',
        meta: '1 semana',
        pitch: 'Te digo exactamente dónde tu negocio está perdiendo tiempo y plata — y qué conviene arreglar primero.',
        features: [
          'Las 3 fugas más grandes de tu operación, con el costo de cada una',
          'Qué vale la pena arreglar, qué no, y en qué orden',
          'Un plan que te sirve aunque nunca más me contrates',
          '100% descontable si contratas cualquier paquete dentro de 30 días',
        ],
        msg: 'Hola Brian, quiero saber dónde estoy perdiendo tiempo y plata en mi negocio (S/ 490).',
        highlight: false,
      },
      {
        name: '"Esta tarea me come la semana"',
        price: 'S/ 1,500',
        meta: '2 semanas',
        pitch: '¿Ese proceso que tú o tu equipo repiten a mano cada semana? Desde ahora funciona solo.',
        features: [
          'Un proceso completo andando sin que nadie lo toque',
          'Funciona con lo que ya tienes — no hay que cambiar nada',
          'Tu equipo lo entiende en simple, no con un manual',
          'Medimos el tiempo que recuperas, antes y después',
        ],
        msg: 'Hola Brian, tengo un proceso manual que me come la semana y quiero automatizarlo (S/ 1,500).',
        highlight: false,
      },
      {
        name: '"Me entero tarde de lo que pasa"',
        price: 'S/ 2,500',
        meta: '21 días',
        pitch: 'Deja de esperar a fin de mes. Ves ventas, costos, stock y ganancia del día en una sola pantalla.',
        features: [
          'Tus números de todas partes, juntos y por fin confiables',
          'Los 8 números que de verdad mueven tus decisiones, no 40 gráficos',
          'Te avisa antes de que algo salga mal, no después',
          'Tu equipo lo usa sin depender de nadie',
          'Garantía de ajustes por 30 días',
        ],
        msg: 'Hola Brian, quiero ver qué pasa en mi negocio sin esperar a fin de mes (S/ 2,500).',
        highlight: true,
      },
      {
        name: '"Las dos cosas"',
        price: 'S/ 3,500',
        meta: '30 días',
        pitch: 'Tus números en una pantalla, y el trabajo que hay detrás funcionando solo.',
        features: [
          'Todo lo del tablero de control',
          'Más un proceso completo automatizado de punta a punta',
          'Los dos construidos para trabajar juntos desde el día uno',
          'Garantía de ajustes por 30 días',
        ],
        msg: 'Hola Brian, quiero el tablero y la automatización juntos (S/ 3,500).',
        highlight: false,
      },
    ],
    retainer: {
      name: '¿Y después?',
      pitch: 'Los problemas siguen apareciendo. Esto es tener a alguien que ya conoce tu negocio, sin meterlo a planilla.',
      note: 'Sin permanencia. Primer mes al 50% si vienes de cualquier paquete de arriba. Una fracción de lo que cuesta un analista en planilla (S/ 3,500 a S/ 5,500 al mes con beneficios).',
      tiers: [
        {
          name: 'Esencial',
          price: 'S/ 890',
          period: '/mes',
          features: [
            'Todo lo que construimos sigue funcionando — yo lo vigilo, tú no',
            'Los ajustes que tu negocio necesite ese mes',
            'Me escribes y te respondo en menos de 48h',
            'Cada mes te digo qué cambió en tus números',
          ],
          msg: 'Hola Brian, quiero saber más del plan mensual Esencial (S/ 890/mes).',
        },
        {
          name: 'Crecimiento',
          price: 'S/ 1,690',
          period: '/mes',
          features: [
            'Todo lo del plan Esencial',
            'Una mejora o automatización nueva cada mes',
            'Respuesta prioritaria en menos de 24h',
            'Tu equipo aprende a sacarle más provecho cada mes',
          ],
          msg: 'Hola Brian, quiero saber más del plan mensual Crecimiento (S/ 1,690/mes).',
        },
      ],
    },
    trust: '50% al inicio / 50% contra entrega · Emitimos factura (el IGV es crédito fiscal para ti) · Trabajo 100% remoto',
  },
} as const;

const t = content[lang];
---

<section class="py-16">
  <!-- Encabezado -->
  <div class="max-w-6xl mx-auto px-4 text-center mb-12">
    <h2 class="text-3xl font-semibold text-foreground">
      {t.heading}
    </h2>
    <p class="mt-3 text-sm max-w-xl mx-auto text-[color:var(--color-text-secondary)]">
      {t.subheading}
    </p>
  </div>

  <!-- Paquetes de proyecto -->
  <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-4 max-w-6xl mx-auto px-4 items-stretch">
    {
      t.plans.map((plan) => (
        <div
          class:list={[
            'relative rounded-xl p-6 flex flex-col justify-between bg-[color:var(--color-bg-secondary)]',
            plan.highlight
              ? 'border-2 border-[color:var(--accent)]'
              : 'border border-[color:var(--color-border)]',
          ]}
        >
          {plan.highlight && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[color:var(--accent)] text-white text-xs font-semibold px-4 py-1 rounded-full whitespace-nowrap">
              {t.popular}
            </div>
          )}

          <div class="space-y-4">
            <div>
              <h3 class="text-lg font-semibold text-foreground leading-snug text-balance">{plan.name}</h3>
              <p class="mt-2">
                <span class="text-2xl font-bold text-[color:var(--accent)]">{plan.price}</span>
                <span class="text-xs ml-2 text-[color:var(--color-text-muted)]">{plan.meta}</span>
              </p>
            </div>

            <p class="text-sm text-[color:var(--color-text-secondary)]">{plan.pitch}</p>

            <ul class="space-y-2 text-sm text-[color:var(--color-text-secondary)]">
              {plan.features.map((f) => (
                <li class="flex gap-2">
                  <span class="text-[color:var(--accent)] shrink-0">✓</span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>

          <a
            href={wa(plan.msg)}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'mt-6 w-full text-white font-semibold rounded-xl px-6 py-4 text-center transition-all duration-200 no-underline shadow-md hover:shadow-lg',
              plan.highlight
                ? 'bg-gradient-to-r from-[var(--accent)] to-[var(--accent-dark)] hover:scale-[1.02]'
                : 'bg-[color:var(--accent)] hover:bg-[color:var(--accent-dark)]',
            ]}
          >
            {t.cta}
          </a>
        </div>
      ))
    }
  </div>

  <!-- Plan recurrente -->
  <div class="max-w-6xl mx-auto px-4 mt-10">
    <div class="rounded-xl p-6 md:p-8 border border-[color:var(--color-border)] bg-[color:var(--color-bg-tertiary)]">
      <div class="text-center mb-6">
        <h3 class="text-2xl font-semibold text-foreground">{t.retainer.name}</h3>
        <p class="mt-2 text-sm text-[color:var(--color-text-secondary)]">{t.retainer.pitch}</p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {
          t.retainer.tiers.map((tier) => (
            <div class="rounded-lg p-5 border border-[color:var(--color-border-light)] bg-[color:var(--color-bg-secondary)] flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-baseline justify-between gap-2">
                  <h4 class="text-lg font-semibold text-foreground">{tier.name}</h4>
                  <p>
                    <span class="text-xl font-bold text-[color:var(--accent)]">{tier.price}</span>
                    <span class="text-xs text-[color:var(--color-text-muted)]">{tier.period}</span>
                  </p>
                </div>
                <ul class="space-y-2 text-sm text-[color:var(--color-text-secondary)]">
                  {tier.features.map((f) => (
                    <li class="flex gap-2">
                      <span class="text-[color:var(--accent)] shrink-0">✓</span>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <a
                href={wa(tier.msg)}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 w-full bg-[color:var(--accent)] hover:bg-[color:var(--accent-dark)] text-white font-semibold rounded-lg px-5 py-3 text-center transition-all duration-200 no-underline"
              >
                {t.cta}
              </a>
            </div>
          ))
        }
      </div>

      <p class="mt-6 text-center text-xs text-[color:var(--color-text-muted)] max-w-2xl mx-auto">
        {t.retainer.note}
      </p>
    </div>

    <p class="mt-6 text-center text-xs text-[color:var(--color-text-muted)]">
      {t.trust}
    </p>
  </div>
</section>
