<section class="py-24">
  <div class="max-w-6xl mx-auto px-4 text-center mb-16">
    <h2 class="text-4xl font-semibold text-white">
      Paquetes de Servicio
    </h2>
    <p class="mt-4 text-gray-400 max-w-2xl mx-auto">
      Soluciones estructuradas según la necesidad y madurez de tu negocio.
    </p>
  </div>

  <div class="grid gap-8 md:grid-cols-3 max-w-6xl mx-auto px-4">

    <!-- Plan 1 -->
    <div class="rounded-2xl p-8 border border-white/10 bg-white/5 flex flex-col gap-6">
      <h3 class="text-xl font-semibold">Diagnóstico de Datos</h3>
      <p class="text-gray-400 text-sm">Ideal para empezar con claridad.</p>

      <ul class="space-y-2 text-gray-300 text-sm">
        <li>✔ Revisión de fuentes</li>
        <li>✔ Evaluación de calidad</li>
        <li>✔ Identificación de errores</li>
        <li>✔ Informe ejecutivo</li>
      </ul>

      <a href="https://wa.me/TUNUMERO"
         class="mt-auto border border-orange-500 text-orange-400 hover:bg-orange-500 hover:text-black rounded-lg px-4 py-2 text-center">
        Agendar diagnóstico
      </a>
    </div>

    <!-- Plan 2 (destacado) -->
    <div class="rounded-2xl p-8 border-2 border-orange-500 bg-orange-500/10 flex flex-col gap-6 scale-105">
      <h3 class="text-xl font-semibold">Control del Negocio (BI)</h3>
      <p class="text-gray-400 text-sm">Dashboard + análisis estratégico.</p>

      <ul class="space-y-2 text-gray-300 text-sm">
        <li>✔ Integración de datos</li>
        <li>✔ Modelado estructurado</li>
        <li>✔ Dashboard en Power BI</li>
        <li>✔ KPIs clave</li>
      </ul>

      <a href="https://wa.me/TUNUMERO"
         class="mt-auto bg-orange-500 text-black hover:bg-orange-400 rounded-lg px-4 py-2 text-center font-medium">
        Solicitar propuesta
      </a>
    </div>

    <!-- Plan 3 -->
    <div class="rounded-2xl p-8 border border-white/10 bg-white/5 flex flex-col gap-6">
      <h3 class="text-xl font-semibold">Optimización Integral</h3>
      <p class="text-gray-400 text-sm">Automatización avanzada y control total.</p>

      <ul class="space-y-2 text-gray-300 text-sm">
        <li>✔ Todo el plan BI</li>
        <li>✔ Automatización de flujos</li>
        <li>✔ Integración de sistemas</li>
        <li>✔ Monitoreo continuo</li>
      </ul>

      <a href="https://wa.me/TUNUMERO"
         class="mt-auto border border-orange-500 text-orange-400 hover:bg-orange-500 hover:text-black rounded-lg px-4 py-2 text-center">
        Hablar sobre mi caso
      </a>
    </div>

  </div>
</section>