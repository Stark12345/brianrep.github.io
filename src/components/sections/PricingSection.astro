---
interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;

const WHATSAPP = '51940167360';
const wa = (msg: string) => `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;

const content = {
  en: {
    heading: 'Packages',
    subheading: 'Choose the problem that matches your business. Fixed price, fixed scope, fixed timeline.',
    popular: 'Most popular',
    cta: 'Talk on WhatsApp',
    plans: [
      {
        name: 'Data Audit',
        price: '$290',
        meta: '1 week',
        pitch: 'I identify exactly where your business is losing time and money, and what is worth resolving first.',
        features: [
          'The 3 biggest leaks in your operation, with the cost of each one',
          'What is worth resolving, what is not, and in which order',
          'An action plan you can use even if you never hire me again',
          '100% credited toward any package within 30 days',
        ],
        msg: 'Hi Brian, I want to identify where my business is losing time and money ($290).',
        highlight: false,
      },
      {
        name: 'Automation Pilot',
        price: '$790',
        meta: '2 weeks',
        pitch: 'That process you or your team repeat by hand every week, running automatically from now on.',
        features: [
          'One full process running with no manual intervention',
          'Integrates with the tools you already use, nothing to replace',
          'Clear documentation so your team can operate it with ease',
          'I measure the time recovered, before and after',
        ],
        msg: 'Hi Brian, I have a manual process that takes up a lot of time and I want it automated ($790).',
        highlight: false,
      },
      {
        name: 'Business Dashboard',
        price: '$1,490',
        meta: '21 days',
        pitch: 'Stop waiting until month end: review the day\'s sales, costs, inventory and profit on a single screen.',
        features: [
          'Your data from every source, integrated and reliable',
          'The indicators that truly guide your decisions, not 40 charts',
          'Alerts before something goes wrong, not after',
          'Your team runs it without depending on anyone',
          '30-day adjustment guarantee',
        ],
        msg: 'Hi Brian, I want to see the state of my business without waiting until month end ($1,490).',
        highlight: true,
      },
      {
        name: 'Dashboard + Automation',
        price: '$1,990',
        meta: '30 days',
        pitch: 'Your indicators on a single screen, and the work behind them running automatically.',
        features: [
          'Everything in the Business Dashboard',
          'Plus one full process automated end to end',
          'Both designed to work together from day one',
          '30-day adjustment guarantee',
        ],
        msg: 'Hi Brian, I want the dashboard and the automation together ($1,990).',
        highlight: false,
      },
    ],
    retainer: {
      name: 'Continuity Plan',
      pitch: 'Business challenges do not stop. This plan means having someone who already knows your operation, without adding them to payroll.',
      note: 'No lock-in. First month 50% off when you come from any previous package. A fraction of what a full-time analyst costs.',
      tiers: [
        {
          name: 'Essential',
          price: '$450',
          period: '/month',
          features: [
            'Maintenance of everything delivered: I keep it monitored for you',
            'The adjustments your business needs each month',
            'Support with a response within 48 hours',
            'A monthly report on how your indicators are evolving',
          ],
          msg: 'Hi Brian, I want to know more about the Essential monthly plan ($450/month).',
        },
        {
          name: 'Growth',
          price: '$890',
          period: '/month',
          features: [
            'Everything in Essential',
            'One new improvement or automation every month',
            'Priority support with a response within 24 hours',
            'Monthly training so your team gets more out of it',
          ],
          msg: 'Hi Brian, I want to know more about the Growth monthly plan ($890/month).',
        },
      ],
    },
    trust: '50% upfront / 50% on delivery · Invoice provided · Remote work worldwide (UTC-5)',
  },

  es: {
    heading: 'Paquetes',
    subheading: 'Elige el problema que se parece a tu negocio. Precio fijo, alcance fijo, plazo fijo.',
    popular: 'Más solicitado',
    cta: 'Conversemos por WhatsApp',
    plans: [
      {
        name: 'Diagnóstico Exprés',
        price: 'S/ 490',
        meta: '1 semana',
        pitch: 'Identifico exactamente dónde tu negocio está perdiendo tiempo y dinero, y qué conviene resolver primero.',
        features: [
          'Las 3 principales fugas de tu operación, con el costo de cada una',
          'Qué vale la pena resolver, qué no, y en qué orden',
          'Un plan de acción que te sirve aunque no vuelvas a contratarme',
          '100% descontable si contratas cualquier paquete dentro de 30 días',
        ],
        msg: 'Hola Brian, quiero identificar dónde estoy perdiendo tiempo y dinero en mi negocio (S/ 490).',
        highlight: false,
      },
      {
        name: 'Piloto de Automatización',
        price: 'S/ 1,500',
        meta: '2 semanas',
        pitch: 'Ese proceso que tú o tu equipo repiten a mano cada semana, funcionando de forma automática.',
        features: [
          'Un proceso completo funcionando sin intervención manual',
          'Se integra con las herramientas que ya usas, sin cambiar nada',
          'Documentación clara para que tu equipo lo opere sin dificultad',
          'Mido el tiempo recuperado, antes y después',
        ],
        msg: 'Hola Brian, tengo un proceso manual que consume mucho tiempo y quiero automatizarlo (S/ 1,500).',
        highlight: false,
      },
      {
        name: 'Tablero de Control',
        price: 'S/ 2,500',
        meta: '21 días',
        pitch: 'Deja de esperar a fin de mes: revisa ventas, costos, inventario y utilidad del día en una sola pantalla.',
        features: [
          'Tus datos de todas las fuentes, integrados y confiables',
          'Los indicadores que realmente guían tus decisiones, no 40 gráficos',
          'Alertas antes de que algo salga mal, no después',
          'Tu equipo lo opera sin depender de nadie',
          'Garantía de ajustes por 30 días',
        ],
        msg: 'Hola Brian, quiero ver el estado de mi negocio sin esperar a fin de mes (S/ 2,500).',
        highlight: true,
      },
      {
        name: 'Tablero + Automatización',
        price: 'S/ 3,500',
        meta: '30 días',
        pitch: 'Tus indicadores en una sola pantalla, y el trabajo que hay detrás funcionando de forma automática.',
        features: [
          'Todo lo del Tablero de Control',
          'Más un proceso completo automatizado de principio a fin',
          'Ambos diseñados para trabajar juntos desde el primer día',
          'Garantía de ajustes por 30 días',
        ],
        msg: 'Hola Brian, quiero el tablero y la automatización juntos (S/ 3,500).',
        highlight: false,
      },
    ],
    retainer: {
      name: 'Plan Continuidad',
      pitch: 'Los retos del negocio no se detienen. Este plan es contar con alguien que ya conoce tu operación, sin sumarlo a planilla.',
      note: 'Sin permanencia. Primer mes al 50% si vienes de cualquier paquete anterior. Una fracción de lo que cuesta un analista en planilla (S/ 3,500 a S/ 5,500 al mes con beneficios).',
      tiers: [
        {
          name: 'Esencial',
          price: 'S/ 890',
          period: '/mes',
          features: [
            'Mantenimiento de todo lo implementado: yo lo superviso por ti',
            'Los ajustes que tu negocio necesite cada mes',
            'Soporte con respuesta en menos de 48 horas',
            'Reporte mensual de la evolución de tus indicadores',
          ],
          msg: 'Hola Brian, quiero saber más del plan mensual Esencial (S/ 890/mes).',
        },
        {
          name: 'Crecimiento',
          price: 'S/ 1,690',
          period: '/mes',
          features: [
            'Todo lo del plan Esencial',
            'Una mejora o automatización nueva cada mes',
            'Soporte prioritario con respuesta en menos de 24 horas',
            'Capacitación mensual para que tu equipo le saque más provecho',
          ],
          msg: 'Hola Brian, quiero saber más del plan mensual Crecimiento (S/ 1,690/mes).',
        },
      ],
    },
    trust: '50% al inicio / 50% contra entrega · Emito factura (el IGV es crédito fiscal para ti) · Trabajo 100% remoto',
  },
} as const;

const t = content[lang];
---

<section class="py-16">
  <!-- Encabezado -->
  <div class="max-w-6xl mx-auto px-4 text-center mb-12">
    <h2 class="text-3xl font-semibold text-foreground">
      {t.heading}
    </h2>
    <p class="mt-3 text-sm max-w-xl mx-auto text-[color:var(--color-text-secondary)]">
      {t.subheading}
    </p>
  </div>

  <!-- Paquetes de proyecto -->
  <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-4 max-w-6xl mx-auto px-4 items-stretch">
    {
      t.plans.map((plan) => (
        <div
          class:list={[
            'relative rounded-xl p-6 flex flex-col justify-between bg-[color:var(--color-bg-secondary)]',
            plan.highlight
              ? 'border-2 border-[color:var(--accent)]'
              : 'border border-[color:var(--color-border)]',
          ]}
        >
          {plan.highlight && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[color:var(--accent)] text-white text-xs font-semibold px-4 py-1 rounded-full whitespace-nowrap">
              {t.popular}
            </div>
          )}

          <div class="space-y-4">
            <div>
              <h3 class="text-lg font-semibold text-foreground leading-snug text-balance">{plan.name}</h3>
              <p class="mt-2">
                <span class="text-2xl font-bold text-[color:var(--accent)]">{plan.price}</span>
                <span class="text-xs ml-2 text-[color:var(--color-text-muted)]">{plan.meta}</span>
              </p>
            </div>

            <p class="text-sm text-[color:var(--color-text-secondary)]">{plan.pitch}</p>

            <ul class="space-y-2 text-sm text-[color:var(--color-text-secondary)]">
              {plan.features.map((f) => (
                <li class="flex gap-2">
                  <span class="text-[color:var(--accent)] shrink-0">✓</span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>

          <a
            href={wa(plan.msg)}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'mt-6 w-full text-white font-semibold rounded-xl px-6 py-4 text-center transition-all duration-200 no-underline shadow-md hover:shadow-lg',
              plan.highlight
                ? 'bg-gradient-to-r from-[var(--accent)] to-[var(--accent-dark)] hover:scale-[1.02]'
                : 'bg-[color:var(--accent)] hover:bg-[color:var(--accent-dark)]',
            ]}
          >
            {t.cta}
          </a>
        </div>
      ))
    }
  </div>

  <!-- Plan recurrente -->
  <div class="max-w-6xl mx-auto px-4 mt-10">
    <div class="rounded-xl p-6 md:p-8 border border-[color:var(--color-border)] bg-[color:var(--color-bg-tertiary)]">
      <div class="text-center mb-6">
        <h3 class="text-2xl font-semibold text-foreground">{t.retainer.name}</h3>
        <p class="mt-2 text-sm text-[color:var(--color-text-secondary)]">{t.retainer.pitch}</p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {
          t.retainer.tiers.map((tier) => (
            <div class="rounded-lg p-5 border border-[color:var(--color-border-light)] bg-[color:var(--color-bg-secondary)] flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-baseline justify-between gap-2">
                  <h4 class="text-lg font-semibold text-foreground">{tier.name}</h4>
                  <p>
                    <span class="text-xl font-bold text-[color:var(--accent)]">{tier.price}</span>
                    <span class="text-xs text-[color:var(--color-text-muted)]">{tier.period}</span>
                  </p>
                </div>
                <ul class="space-y-2 text-sm text-[color:var(--color-text-secondary)]">
                  {tier.features.map((f) => (
                    <li class="flex gap-2">
                      <span class="text-[color:var(--accent)] shrink-0">✓</span>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <a
                href={wa(tier.msg)}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 w-full bg-[color:var(--accent)] hover:bg-[color:var(--accent-dark)] text-white font-semibold rounded-lg px-5 py-3 text-center transition-all duration-200 no-underline"
              >
                {t.cta}
              </a>
            </div>
          ))
        }
      </div>

      <p class="mt-6 text-center text-xs text-[color:var(--color-text-muted)] max-w-2xl mx-auto">
        {t.retainer.note}
      </p>
    </div>

    <p class="mt-6 text-center text-xs text-[color:var(--color-text-muted)]">
      {t.trust}
    </p>
  </div>
</section>
