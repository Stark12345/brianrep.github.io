---
import Carousel from '../ui/carousel/Carousel.astro';
import { logos } from '../../data/logos';
interface SkillItem {
  icon: string; // inline SVG
  title: string;
  description: string;
}

interface Props {
  title?: string;
  /** Etiqueta discreta para el carrusel de herramientas. Las herramientas van SUBORDINADAS
   *  a los problemas: primero qué resolvemos, después con qué. */
  toolsLabel?: string;
  /** Línea que desactiva la intimidación del carrusel para el lector NO técnico (el dueño de
   *  PyME reconoce como mucho "Excel"), sin quitarle valor al lector técnico que sí identifica
   *  el stack. Ver bn_information/simulacion_dueno_restaurantes.md */
  toolsNote?: string;
  skills: SkillItem[];
}

const { title, toolsLabel, toolsNote, skills } = Astro.props as Props;
---

<section class="w-full py-8">
  <div class="mx-auto max-w-6xl px-4">
    {title && (
      <h2 class="text-3xl md:text-4xl font-semibold text-center mb-8 text-foreground">{title}</h2>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
      {skills.map((skill) => (
        <div class="card-surface p-6 group transition-transform duration-200 hover:-translate-y-1 hover:elevate-lg">
          <div class="flex flex-col items-center text-center">
            <div class="mb-4 rounded-xl size-[48px] flex items-center justify-center text-[var(--accent)] opacity-90 transition-all duration-300 will-change-transform group-hover:scale-110 group-hover:opacity-100 [&>svg]:w-6 [&>svg]:h-6" style="background: rgba(var(--accent-rgb),0.08);" set:html={skill.icon} />
            <h3 class="text-xl font-semibold text-foreground mb-2">{skill.title}</h3>
            <p class="text-[color:var(--color-text-muted)] leading-relaxed max-w-prose">{skill.description}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-14">
      {toolsLabel && (
        <p class="text-center text-sm uppercase tracking-wide text-[color:var(--color-text-muted)] mb-2">
          {toolsLabel}
        </p>
      )}
      {toolsNote && (
        <p class="text-center text-sm max-w-xl mx-auto mb-4 text-[color:var(--color-text-muted)]">
          {toolsNote}
        </p>
      )}
      <Carousel tools={logos} />
    </div>
  </div>
</section>


