---
import { routes, ui, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  /** Página actual, para saltar a su equivalente en el otro idioma */
  page?: keyof typeof routes.en;
  class?: string;
}

const { lang, page = 'home', class: className = '' } = Astro.props;

const options = [
  { code: 'en' as Lang, href: routes.en[page], label: ui[lang]['lang.en'], short: 'EN' },
  { code: 'es' as Lang, href: routes.es[page], label: ui[lang]['lang.es'], short: 'ES' },
];
---

<div class:list={['flex items-center gap-1', className]} role="group" aria-label="Language">
  {
    options.map((opt) => {
      const isActive = opt.code === lang;
      return (
        <a
          href={opt.href}
          hreflang={opt.code}
          title={opt.label}
          aria-label={opt.label}
          aria-current={isActive ? 'true' : undefined}
          class:list={[
            'inline-flex items-center gap-1 rounded-md border px-1.5 py-1 no-underline transition-all',
            isActive
              ? 'border-[color:var(--accent)] opacity-100'
              : 'border-transparent opacity-50 hover:opacity-100 hover:border-[color:var(--color-border)]',
          ]}
        >
          {opt.code === 'en' ? (
            /* Bandera de Estados Unidos (simplificada) */
            <svg viewBox="0 0 20 14" width="20" height="14" aria-hidden="true" class="rounded-[2px] shrink-0">
              <rect width="20" height="14" fill="#fff" />
              <g fill="#B22234">
                <rect y="0" width="20" height="1.08" />
                <rect y="2.15" width="20" height="1.08" />
                <rect y="4.31" width="20" height="1.08" />
                <rect y="6.46" width="20" height="1.08" />
                <rect y="8.62" width="20" height="1.08" />
                <rect y="10.77" width="20" height="1.08" />
                <rect y="12.92" width="20" height="1.08" />
              </g>
              <rect width="8" height="7.54" fill="#3C3B6E" />
            </svg>
          ) : (
            /* Bandera del Perú */
            <svg viewBox="0 0 20 14" width="20" height="14" aria-hidden="true" class="rounded-[2px] shrink-0">
              <rect width="20" height="14" fill="#fff" />
              <rect width="6.67" height="14" fill="#D91023" />
              <rect x="13.33" width="6.67" height="14" fill="#D91023" />
            </svg>
          )}
          <span class="text-[11px] font-semibold text-[color:var(--color-text-secondary)]">
            {opt.short}
          </span>
        </a>
      );
    })
  }
</div>
